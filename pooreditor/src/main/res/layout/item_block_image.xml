<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/re_bg_block"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSortNum"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/re_bg_sort_num"
                android:gravity="center"
                android:textColor="@color/re_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnDrag"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/re_drag"
                android:src="@drawable/re_ic_drag"
                app:tint="@color/re_text_hint" />

            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="14dp"
                android:contentDescription="@string/re_delete"
                android:src="@drawable/re_ic_close"
                app:tint="@color/re_text_hint" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/re_block"
                android:contentDescription="@string/re_image"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/REMediaShape" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/re_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvUploadStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:background="@drawable/re_bg_badge"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
